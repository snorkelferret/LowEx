# deploy/site.env.example
#
# THE FACTS ONE INSTALLATION NEEDS, IN ONE FILE.
#
# Copy to deploy/site.env (gitignored) on the machine doing the installing, and
# fill it in. Every part script reads it; no part holds an address of its own
# (check:config enforces that).
#
# LOCAL AND REMOTE ARE THE SAME SHAPE. Locally these name 127.0.0.1; on the
# server they name the domain. The values change; the scripts do not.
#
# NEVER PUT A PASSWORD OR A TOKEN IN THIS FILE. The portal's secrets live in
# website/.env on the host; the trigger's in its own 0600 file. This file is
# addresses, paths and account names only, and it may be copied between machines
# without carrying a credential.

# ---------------------------------------------------------------------------
# Names and addresses
# ---------------------------------------------------------------------------

# The domain visitors use. The proxy's server_name, and PUBLIC_URL should agree.
PUBLIC_HOST=lowexpectations.zone

# Where the proxy forwards to — the portal's loopback address and port.
UPSTREAM=127.0.0.1:5000

# Where the proxy's certificate pair lives (Cloudflare Origin Certificate).
CERT_DIR=/etc/ssl/cloudflare

# How the portal is addressed. Must match the browser and the OAuth callback.
PORTAL_URL=https://lowexpectations.zone

# The Perforce server address, for the trigger and the perforce part.
P4PORT=vcs.lowexpectations.zone:1666

# ---------------------------------------------------------------------------
# Paths and accounts
# ---------------------------------------------------------------------------

# Where the repository is checked out on this host.
CHECKOUT=/srv/lowex

# The account the portal and the daily job run as. It must own
# backend/database.db and backend/uploads/.
SERVICE_USER=lowex
SERVICE_GROUP=lowex

# Where backups are written, for the backups part.
BACKUP_DIR=/var/backups/lowex

# ---------------------------------------------------------------------------
# Perforce, for the perforce part (TODO 88)
# ---------------------------------------------------------------------------

# The server root: db.*, journals and logs. Owned by the p4d service account.
P4_ROOT=/srv/perforce

# The depot and the mainline stream inside it.
P4DEPOT=//LowExpectations
P4STREAM=//LowExpectations/main

# An existing Perforce user with super rights. The installer does not create
# it; it must exist before a protections table can name it.
P4_SUPER_USER=game-admin

# Where the trigger script is installed, and the 0600 file with its three
# values (PORTAL_URL, P4PORT, PERFORCE_TRIGGER_TOKEN). The installer checks it
# but NEVER creates the secret.
PERFORCE_TRIGGER_SCRIPT=/usr/local/lib/lowex/change-commit.sh
PERFORCE_TRIGGER_ENV=/etc/lowex/perforce-trigger.env

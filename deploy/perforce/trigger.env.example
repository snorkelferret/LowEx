# Copy this to somewhere only the Perforce service account can read, e.g.
#   /etc/lowex/perforce-trigger.env   (chmod 600)
#
# THE TRIGGER REQUIRES ALL THREE. There are no defaults: a default address in a
# trigger is a notification sent somewhere nobody chose.
#
# Locally these are the sandbox values; on the server they are the public ones.
# Nothing in the trigger script or the portal changes between the two.

# Where the portal is. Locally: http://127.0.0.1:5000.
PORTAL_URL=http://127.0.0.1:5000

# The Perforce server the trigger describes changelists against: host:port.
P4PORT=127.0.0.1:1666

# The same value as PERFORCE_TRIGGER_TOKEN in the portal's .env. Generate one:
#   openssl rand -hex 32
# Never put the real value in this file in git — this is the template.
PERFORCE_TRIGGER_TOKEN=change_me

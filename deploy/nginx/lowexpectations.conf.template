# A TEMPLATE. Do not install this file; run deploy/nginx/install.sh, which
# substitutes PUBLIC_HOST, CERT_DIR and UPSTREAM from the environment. The
# portal's address is therefore a VALUE, not a line in a file somebody edits
# when the domain changes.
#
# deploy/nginx/lowexpectations.conf
#
# THE REVERSE PROXY IN FRONT OF THE PORTAL.
#
# ============================================================
# WHAT THIS ASSUMES
# ============================================================
#
#   * The application binds 127.0.0.1:5000 and never faces the network
#     (TODO 44, proved by `npm run check:bind`).
#   * Cloudflare is in front, proxying the domain (orange cloud), and THE
#     ORIGIN ACCEPTS CONNECTIONS FROM CLOUDFLARE ONLY — a firewall rule against
#     the published ranges, or a Cloudflare Tunnel that leaves no inbound port
#     at all. Without that, every Cloudflare rule is bypassable by connecting
#     straight to this IP with the right Host header (TODO 48).
#   * TLS at the origin is a Cloudflare ORIGIN CERTIFICATE — a certificate
#     Cloudflare issues for this zone, valid for up to fifteen years, installed
#     here and used for the Cloudflare-to-origin leg (SSL/TLS mode: Full
#     strict). The visitor's TLS is Cloudflare's.
#
# WHY NOT LET'S ENCRYPT AUTOMATICALLY: with the origin reachable only from
# Cloudflare, an ACME HTTP-01 challenge has nothing to answer it at the origin.
# The Origin Certificate is the standard answer, and it is why both certificate
# paths below point into /etc/ssl/cloudflare/.
#
# ============================================================
# INSTALLING IT
# ============================================================
#
#   sudo cp deploy/nginx/lowexpectations.conf /etc/nginx/sites-available/
#   sudo ln -s /etc/nginx/sites-available/lowexpectations.conf \
#              /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# See deploy/README.md for the Cloudflare ranges file, the origin certificate
# and the checks that prove the result.
#
# ============================================================
# CLOUDFLARE'S ADDRESSES, AND WHY THEY ARE AN INCLUDE
# ============================================================
#
# `real_ip` needs Cloudflare's ranges so the portal sees the VISITOR'S address
# rather than Cloudflare's — the failure item 48 describes, where a rule built
# on req.ip would block Cloudflare, which is everybody. The ranges CHANGE, so
# they are generated into their own file rather than pasted here and forgotten:
#
#   see deploy/README.md, "Cloudflare's ranges"
#
# The file is a list of `set_real_ip_from ...;` lines plus one
# `real_ip_header CF-Connecting-IP;`.

include /etc/nginx/cloudflare-ips.conf;

# ============================================================
# HTTP, WHICH ONLY EVER REDIRECTS
# ============================================================

server {
    listen      80;
    listen      [::]:80;
    server_name ${PUBLIC_HOST};

    # Cloudflare already terminates TLS for visitors. This catches a stray
    # direct request — and a browser that typed the name without a scheme.
    return 301 https://$host$request_uri;
}

# ============================================================
# HTTPS
# ============================================================

server {
    listen      443 ssl;
    listen      [::]:443 ssl;

    # nginx 1.25.1 and later. On an older nginx, delete this line and add
    # `http2` to the two listen directives above.
    http2       on;

    server_name ${PUBLIC_HOST};

    # The Cloudflare Origin Certificate. Paths are the ones Cloudflare's own
    # instructions use; the filenames can be anything, the pair must match.
    ssl_certificate     ${CERT_DIR}/${PUBLIC_HOST}.pem;
    ssl_certificate_key ${CERT_DIR}/${PUBLIC_HOST}.key;

    # TLS 1.0/1.1 are refused. The origin leg is between Cloudflare and this
    # machine; 1.2 and 1.3 are what both ends speak.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS tells the browser never to try plain HTTP for this host again. It is
    # only safe once HTTPS is genuinely in place — which is why it is here, at
    # the proxy, and not in the application.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Do not announce the server version to the world.
    server_tokens off;

    # ========================================================
    # BODIES, WHICH ARE BIG HERE
    # ========================================================
    #
    # nginx's default is 1 MB, which would refuse every asset upload before it
    # reached the application. Six gigabytes is a TRANSPORT CEILING, not a
    # policy: it sits just above the default 5 GB workspace allowance
    # (workspace_limit_gb in backend/lib/settings.js) so a developer can send a
    # bundle their quota would allow, and it stops an anonymous client filling
    # the disk one request at a time.
    #
    # THE REAL CONTROL IS THE APPLICATION'S QUOTA CHECK, and a per-request
    # limit is still wanted there (TODO item 9). When that lands, this number
    # should be revisited so the two do not disagree.
    client_max_body_size 6g;

    # A large upload over a slow line is not an error.
    client_body_timeout 300s;
    send_timeout        300s;

    location / {
        proxy_pass http://${UPSTREAM};

        # Keep the visitor's host so links and redirects the app builds are
        # right, and keep the scheme so anything that asks is told https.
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;

        # The technical check hashes every file, and an archive can be
        # hundreds of megabytes. Both are slow and legitimate.
        proxy_read_timeout 300s;

        # UPLOADS AND DOWNLOADS ARE STREAMED, NOT STORED TWICE.
        # request_buffering off lets an upload pass through as it arrives
        # instead of nginx writing the whole body to disk first; buffering off
        # lets a zip start downloading before it has been fully built.
        proxy_request_buffering off;
        proxy_buffering         off;

        # The application sets its own Content-Type and nosniff on the file
        # routes. Do not add a second opinion here.
        proxy_pass_request_headers on;
    }
}

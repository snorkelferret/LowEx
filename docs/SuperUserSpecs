// Variable to store temporary username between Step 1 and Step 2
let pendingUsername = '';

// DOM Elements
const loginForm = document.getElementById('login-form');
const step1Container = document.getElementById('step1-container');
const step2Container = document.getElementById('step2-container');
const formError = document.getElementById('form-error');

// 1. STEP 1: Handle Username & Password Submission
loginForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  formError.textContent = ''; // Clear previous errors

  const usernameInput = document.getElementById('username').value;
  const passwordInput = document.getElementById('password').value;

  try {
    const response = await fetch('/api/auth/login-step1', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: usernameInput, password: passwordInput })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Login failed');
    }

    if (data.requires2FA) {
      // Save username and reveal 2FA Step 2 input
      pendingUsername = usernameInput;
      step1Container.style.display = 'none';
      step2Container.style.display = 'block';
    } else {
      // Direct login if 2FA is not enforced
      saveSessionAndRedirect(data.token, data.user);
    }
  } catch (err) {
    formError.textContent = err.message;
  }
});

// 2. STEP 2: Handle 2FA Authenticator Code Submission
const verify2FABtn = document.getElementById('verify-2fa-btn');

verify2FABtn?.addEventListener('click', async () => {
  formError.textContent = '';
  const totpCode = document.getElementById('totp-code').value;

  if (!totpCode) {
    formError.textContent = 'Please enter your 6-digit authenticator code.';
    return;
  }

  try {
    const response = await fetch('/api/auth/login-step2', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: pendingUsername, code: totpCode })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Invalid 2FA code');
    }

    // Save token and navigate to portal dashboard
    saveSessionAndRedirect(data.token, data.user);
  } catch (err) {
    formError.textContent = err.message;
  }
});

// Helper function to handle session storage and redirection
function saveSessionAndRedirect(token, user) {
  localStorage.setItem('jwt_token', token);
  localStorage.setItem('user_info', JSON.stringify(user));
  
  alert(`Welcome back, ${user.username}!`);
  // Redirect to dashboard or protected area
  window.location.href = '/portal.html';
}

            ctx.beginPath();

            ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);

            ctx.fill();



            ctx.strokeStyle = '#ffffff';

            ctx.lineWidth = 2;

            ctx.stroke();

        }




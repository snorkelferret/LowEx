// backend/seed-invites.js
const Database = require('better-sqlite3');
const crypto = require('crypto');
const path = require('path');

const db = new Database(path.join(__dirname, 'database.db'));

// List of people to invite
const invitees = [
  { email: 'lead.dev@lowexpectations.com', role: 'developer' },
  { email: 'contractor@external.com', role: 'developer' },
  { email: 'co-admin@lowexpectations.com', role: 'admin' }
];

const insertInvite = db.prepare(`
  INSERT OR IGNORE INTO invitations (email, assigned_role, token)
  VALUES (?, ?, ?)
`);

console.log('✉️ Generating invitations...\n');

invitees.forEach(({ email, role }) => {
  const token = crypto.randomBytes(16).toString('hex');
  const result = insertInvite.run(email, role, token);

  if (result.changes > 0) {
    console.log(`✅ Invited: ${email} (${role})`);
    console.log(`   Invite Link: http://localhost:5173/portal.html?invite_token=${token}\n`);
  } else {
    console.log(`⚠️  Skipped (Already invited/registered): ${email}`);
  }
});

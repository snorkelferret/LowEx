// Seed initial Superuser on first boot if database is empty
const seedSuperUser = () => {
  const superuserEmail = process.env.INITIAL_SUPERUSER_EMAIL || 'admin@yourdomain.com';
  
  const existingUser = db.prepare('SELECT id FROM users WHERE email = ?').get(superuserEmail);
  
  if (!existingUser) {
    // Insert initial superuser invite into invitations table
    db.prepare(`
      INSERT OR IGNORE INTO invitations (email, assigned_role, token)
      VALUES (?, 'superuser', 'INITIAL_BOOTSTRAP_TOKEN')
    `).run(superuserEmail);
    
    console.log(`🔑 Whitelisted initial superuser email: ${superuserEmail}`);
  }
};
Security Summary
User Type	Can Register Publicly?	Allowed Auth Methods
user (Customer)	Yes	Password / Public Signup
developer	NO (Invitation required)	GitHub OR Password (must match invited email)
admin	NO (Invitation required)	GitHub OR Password (must match invited email)
superuser	NO (Created by system/existing superuser)	GitHub OR Password (must match invited email)
￼
This prevents random users from logging in with GitHub or registering elevated accounts without an explicit admin invitation.


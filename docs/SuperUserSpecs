import express from 'express';
import Database from 'better-sqlite3';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
app.use(express.json());

// 1. Initialize SQLite Database file inside backend/ directory
const dbPath = path.join(__dirname, 'database.db');
const db = new Database(dbPath);

// Enable WAL mode for high performance
db.pragma('journal_mode = WAL');

// 2. Create Users Table
const initDb = () => {
  const createUsersTable = `
    CREATE TABLE IF NOT EXISTS users (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      email TEXT UNIQUE NOT NULL,
      password_hash TEXT NOT NULL,
      role TEXT CHECK(role IN ('user', 'admin', 'superuser')) NOT DEFAULT 'user',
      is_active INTEGER DEFAULT 1,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    );
  `;
  
  db.exec(createUsersTable);
  console.log('⚡ SQLite Database initialized successfully.');
};

initDb();

// ------------------- Helper DB Statements -------------------

// Prepared statements are pre-compiled for security and speed (prevents SQL injection)
const queries = {
  createUser: db.prepare(`
    INSERT INTO users (email, password_hash, role) 
    VALUES (@email, @password_hash, @role)
  `),
  getUserByEmail: db.prepare(`
    SELECT * FROM users WHERE email = ?
  `),
  getUserById: db.prepare(`
    SELECT id, email, role, is_active, created_at FROM users WHERE id = ?
  `),
  getAllUsers: db.prepare(`
    SELECT id, email, role, is_active, created_at FROM users
  `)
};

// ------------------- API Endpoints -------------------

// GET all users (For testing / Admin portal)
app.get('/api/users', (req, res) => {
  try {
    const users = queries.getAllUsers.all();
    res.json(users);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

// Start Express Server
const PORT = process.env.PORT || 5000;
app.listen(PORT, () => {
  console.log(`🚀 Auth Service running on http://localhost:${PORT}`);
});

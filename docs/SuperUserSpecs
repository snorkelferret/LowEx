-- Core Account Table
CREATE TABLE users (
    id VARCHAR(36) PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    two_factor_secret VARCHAR(255),
    is_2fa_enabled BOOLEAN DEFAULT TRUE,
    is_contributor BOOLEAN DEFAULT FALSE, -- Toggles personal updates/devlog page
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Roles Definition (superuser, dev, user)
CREATE TABLE roles (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(36) UNIQUE NOT NULL
);

-- Permission Granules
CREATE TABLE permissions (
    id INT PRIMARY KEY AUTO_INCREMENT,
    slug VARCHAR(100) UNIQUE NOT NULL -- e.g., 'access:admin-dashboard', 'view:telemetry', 'manage:cloudflare'
);

-- Mapping Users to Roles
CREATE TABLE user_roles (
    user_id VARCHAR(36),
    role_id INT,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (role_id) REFERENCES roles(id)
);

-- Mapping Roles to Permissions
CREATE TABLE role_permissions (
    role_id INT,
    permission_id INT,
    FOREIGN KEY (role_id) REFERENCES roles(id),
    FOREIGN KEY (permission_id) REFERENCES permissions(id)
);

# Copy to .env and fill in. Never commit .env — only this template.
#
#   cp .env.example .env
#
# The server refuses to start without JWT_SECRET, so that one is not optional.
# Everything else has a working default, and leaving the SMTP block empty is a
# supported configuration — see the note at the bottom.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000

# WHERE THE SOCKET LISTENS. 127.0.0.1 is LOOPBACK: reachable only from this
# machine, with the reverse proxy as the only way in. Do not set 0.0.0.0 —
# that is every interface, including the ones facing the network.
BIND=127.0.0.1

# HOW THE PORTAL IS ADDRESSED by a browser, and by Google's OAuth callback.
# NOT the bind address: in production this is https://lowexpectations.zone
# while the socket is on 127.0.0.1:5000.
PUBLIC_URL=http://localhost:5000

# WHERE THE DEVELOPMENT FRONTEND PROXIES /api. 127.0.0.1, NOT localhost: the
# server binds IPv4 loopback, and `localhost` may resolve to ::1 first — so
# "localhost" fails to connect on a machine where it does.
SERVER_URL=http://127.0.0.1:5000

# The frontend origin. Used for CORS, for OAuth redirects, and for building
# invitation links — so it must be the address a real person can open, not
# localhost, once this is deployed anywhere.
CLIENT_URL=http://localhost:5173

# Where the frontend finds the API during development.
VITE_API_URL=http://localhost:5000
VITE_DEFAULT_START_PAGE=/index.html

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# REQUIRED. The server exits if this is missing rather than falling back to a
# default, because a default would mean every session is signed with a value
# that lives in the repository.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me

# Google OAuth. Optional — login works without it, the Google button does not.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Optional, and safe to leave empty.
#
# With these blank, invitations are still created and the link is returned in
# the API response instead of being sent, so the inviter passes it on by hand.
# The application does not fail; it just does not email. Fill these in and
# invitations start arriving by themselves.
#
# SMTP_USER and SMTP_PASS are optional as a pair — a local relay often needs no
# authentication. Setting only one of them is refused, because the relay would
# reject every message with a confusing error.

SMTP_HOST=
SMTP_PORT=587

# Set to true for implicit TLS, which is normally port 465. Leave false for
# STARTTLS on 587.
SMTP_SECURE=false

SMTP_USER=
SMTP_PASS=

# The From: address on outgoing mail. Some providers reject a From that does
# not match the authenticated account.
MAIL_FROM=Low Expectations <no-reply@lowexpectations.zone>

# ---------------------------------------------------------------------------
# Community
# ---------------------------------------------------------------------------
# The discussion board. Deliberately service-neutral: this is the invite or
# join URL, and the application does not care which product it points at.
#
# Requirements that were decided: open source, and hosted in the UK or EU so
# the conversation is not subject to US jurisdiction. The choice is recorded in
# TODO item 27.
#
# Left blank, the discussion page says it is not configured rather than
# offering a dead join link.
VITE_DISCUSSION_URL=

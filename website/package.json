{
  "name": "low-expectations-website",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "generate:pages": "node build.js",
    "check:routes": "node scripts/check-route-order.js",
    "check:schema": "node scripts/check-schema-drift.js",
    "check:naming": "node scripts/check-naming.js",
    "check:dom": "node scripts/check-dom-ids.js",
    "check:store": "node scripts/check-store.js",
    "check:collector": "node scripts/check-collector.js",
    "check:preview": "node scripts/check-preview-access.js",
    "check:approval": "node scripts/check-approval-path.js",
    "check:upload-pending": "node scripts/check-upload-pending.js",
    "check:round-trip": "node scripts/check-download-round-trip.js",
    "check:releases": "node scripts/check-releases.js",
    "check:library": "node scripts/check-library-access.js",
    "check:perforce": "node scripts/check-perforce-notify.js",
    "check:integration": "node scripts/check-integration-path.js",
    "check:bind": "node scripts/check-bind.js",
    "check:config": "node scripts/check-config.js",
    "check": "npm run check:routes && npm run check:schema && npm run check:naming && npm run check:dom && npm run check:store && npm run check:collector && npm run check:preview && npm run check:approval && npm run check:upload-pending && npm run check:round-trip && npm run check:releases && npm run check:library && npm run check:perforce && npm run check:integration && npm run check:bind && npm run check:config",
    "predev": "npm run generate:pages && npm run generate:manual",
    "prebuild": "npm run generate:pages && npm run generate:manual",
    "build": "vite build",
    "start:backend": "node backend/server.js",
    "start:frontend": "vite",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "generate:manual": "node scripts/build-manual.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "bootstrap": "^5.3.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.3",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "marked": "^18.0.14",
    "vite": "^8.2.0"
  }
}

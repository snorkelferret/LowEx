{
  "name": "low-expectations-website",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "generate:pages": "node build.js",
    "check:routes": "node scripts/check-route-order.js",
    "check:schema": "node scripts/check-schema-drift.js",
    "check:naming": "node scripts/check-naming.js",
    "check:dom": "node scripts/check-dom-ids.js",
    "check:store": "node scripts/check-store.js",
    "predev": "npm run generate:pages && npm run generate:manual",
    "prebuild": "npm run generate:pages && npm run generate:manual",
    "build": "vite build",
    "start:backend": "node backend/server.js",
    "start:frontend": "vite",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "generate:manual": "node scripts/build-manual.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "bootstrap": "^5.3.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.3",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "marked": "^18.0.14",
    "vite": "^8.2.0"
  }
}

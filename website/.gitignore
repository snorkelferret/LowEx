# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
backend/node_modules/

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
# .env holds JWT_SECRET and the Google OAuth client secret.
# Add a committed .env.example with placeholder values instead.
.env
.env.*
.env~
# ...but .env.example IS committed — it is the template a new clone starts
# from, and carries no secrets.
!.env.example
#.env#
#.env#

# ---------------------------------------------------------------------------
# Database — contains user records, bcrypt password hashes and TOTP secrets.
# Never commit this.
# ---------------------------------------------------------------------------
backend/database.db
backend/database.db-wal
backend/database.db-shm
backend/reset/database.db*

# ---------------------------------------------------------------------------
# User-uploaded content (developer asset store + multer temp dir)
# ---------------------------------------------------------------------------
backend/uploads/

# ---------------------------------------------------------------------------
# Editor / OS junk
# ---------------------------------------------------------------------------
*~
\#*\#
.\#*
*.swp
*.swo
*.log
.DS_Store

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# Vite bundles into frontend/dist, which is what backend/server.js serves.
frontend/dist/

# Pages assembled by build.js from frontend/src/components/*.html.
# These are generated — edit the components, not these. Committing them is how
# devDashboard.html and components/developerAssets.html drifted apart.
# Regenerated automatically by `npm run dev` / `npm run build` (predev/prebuild).
frontend/adminDashboard.html
frontend/superuserDashboard.html
frontend/devDashboard.html
frontend/register.html

# The manual, assembled by scripts/build-manual.js from ../docs/manual/*.md.
#
# Generated under backend/ rather than frontend/dist/ ON PURPOSE. Everything in
# dist is served statically, before any route runs, so a page placed there is
# fetchable by anyone whatever guards the route meant to protect it. The manual
# contains how the server is run and what administrators can do, so it is built
# outside the static tree and served only through GET /app/manual.
backend/generated/

# Stray empty directory at the repo root, superseded by frontend/dist.
/dist/

# Scratch space, for things that are thrown away as soon as they are made —
# screenshots, DOM dumps, test fixtures.
#
# IN HERE AND NOT IN /tmp, deliberately. /tmp is outside the project, so
# anything left there is invisible: you would only find it by going looking, and
# you could not tell at a glance which files were mine and which were yours.
# Here, it is obviously scratch, obviously disposable, and it is cleared out
# rather than accumulating.
.tmp/
